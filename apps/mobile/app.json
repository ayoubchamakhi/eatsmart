{
  "expo": {
    "name": "Eatsmart",
    "slug": "eatsmart",
    "scheme": "eatsmart",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FBF9F5"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.eatsmart.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FBF9F5"
      },
      "package": "com.eatsmart.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Eatsmart utilise la caméra pour scanner les codes-barres de vos produits en rayon."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Eatsmart utilise vos photos pour ajouter les emballages des produits alimentaires."
        }
      ]
    ]
  }
}
